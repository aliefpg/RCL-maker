{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "functions": {
    "api/[...path].js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/Resume.html"
    },
    {
      "source": "/surat",
      "destination": "/Cover_Letter.html"
    },
    {
      "source": "/cv",
      "destination": "/CV.html"
    }
  ]
}
