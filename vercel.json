
{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "functions": {
    "api/[...path].js": {
      "maxDuration": 60
    },
    "api/mcp.js": {
      "maxDuration": 60
    },
    "api/cron/cleanup-rcl-files.js": {
      "maxDuration": 60
    },
    "api/signature-upload/[token].js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/Resume.html"
    },
    {
      "source": "/surat",
      "destination": "/Cover_Letter.html"
    },
    {
      "source": "/cv",
      "destination": "/CV.html"
    }
  ],
  "installCommand": "npm install"
}
