# Configure these in Vercel Project Settings > Environment Variables.
# Keep the token secret. Multiple users: token:user-id,token2:user-id2
MCP_API_KEYS=replace-with-a-long-random-token:owner

# Use the production URL of THIS SAME RCL Maker Vercel project.
# Example: https://your-rcl-maker.vercel.app
RCL_API_BASE_URL=https://your-rcl-maker.vercel.app
RCL_API_TIMEOUT_MS=90000

# Temporary document delivery (Vercel Blob)
BLOB_READ_WRITE_TOKEN=
MCP_DOWNLOAD_SECRET=replace-with-a-long-random-secret
MCP_PUBLIC_BASE_URL=https://your-rcl-maker-domain.vercel.app
